# Copy to .env (never commit real values). Secrets may instead be mounted as files: NOTIV_AUTH_SECRET_FILE=/run/secrets/auth
NOTIV_ENV=development                 # production => fail-closed config validation
NOTIV_AUTH_SECRET=                    # >=32 random bytes: python -c "import secrets;print(secrets.token_urlsafe(48))"
# NOTIV_AUTH_SECRET_PREVIOUS=         # comma-separated rotated-out secrets still accepted
# NOTIV_AUTH_ISSUER= / NOTIV_AUTH_AUDIENCE= / NOTIV_AUTH_MAX_TTL_SECONDS=3600
NOTIV_DATABASE_URL=                   # postgresql://user:pass@host:5432/notiv  (empty => SQLite file, dev only)
NOTIV_LECTURE_DB=storage/lectures.db  # SQLite path when NOTIV_DATABASE_URL is empty
NOTIV_STORAGE=local                   # local | s3 (production requires s3)
NOTIV_STORAGE_DIR=storage/objects
NOTIV_SIGNING_SECRET=                 # local storage: >=32 bytes, different from the auth secret
# NOTIV_S3_BUCKET= NOTIV_S3_PREFIX= NOTIV_S3_ENDPOINT= NOTIV_S3_REGION= NOTIV_S3_SSE=AES256
NOTIV_SIGNED_URL_MAX_SECONDS=3600
NOTIV_CORS_ORIGINS=                   # comma-separated origins; '*' is rejected
NOTIV_TRUST_PROXY=0                   # 1 only behind a proxy you control (uses X-Forwarded-For)
NOTIV_METRICS_ENABLED=0               # 1 + NOTIV_METRICS_TOKEN to expose /metrics
NOTIV_METRICS_TOKEN=
NOTIV_INPROCESS_WORKER=1              # 0 when running `python -m core.lecture.worker` separately (recommended in production)
# Limits: NOTIV_RL_<READ|WRITE|UPLOAD|PROCESS|ASK|STUDY|AUTH_FAIL>=max/seconds ; NOTIV_RATELIMIT_BACKEND=memory
# NOTIV_RATELIMIT_ON_ERROR=local        # shared store down: local = per-process limits (DEGRADED, reported) | deny = 503|db
# Production: NOTIV_RATELIMIT_BACKEND=db (shared by all replicas) OR NOTIV_SINGLE_INSTANCE=1 (exactly one API process; startup refuses otherwise)
NOTIV_RATELIMIT_BACKEND=memory
# NOTIV_RATELIMIT_ON_ERROR=local        # shared store down: local = per-process limits (DEGRADED, reported) | deny = 503
# Quotas: NOTIV_QUOTA_<LECTURES|STORAGE_MB|ASSETS_PER_LECTURE|UPLOADS_PER_DAY|ACTIVE_JOBS|ASKS_PER_DAY> (<=0 disables)
NOTIV_LOG_LEVEL=INFO
NOTIV_LOG_FORMAT=json
# Personal notes quota per user per lecture (<=0 disables)
NOTIV_QUOTA_NOTES_PER_LECTURE=1000
# Answer models (Ask Notiv wording, general-knowledge follow-ups, AI practice quiz). Tried in this order; a provider
# without a key is skipped, a failing one is cooled down and the next is tried. No provider -> Ask answers with verbatim
# lecture quotes only and the AI quiz returns 503. Lecture excerpts are sent to the provider that answers.
NOTIV_LLM_PROVIDERS=openai,groq,mistral,anthropic # add "lovable" (LOVABLE_API_KEY) to use the Lovable AI Gateway
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
# NOTIV_OPENAI_MODEL=gpt-6-astra  NOTIV_OPENAI_EFFORT=low   (OPENAI_MODEL / OPENAI_BASE_URL are honoured too; NOTIV_* wins)
# NOTIV_GROQ_MODEL=openai/gpt-oss-120b  NOTIV_GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Reading handwritten / scanned / garbled pages with an image-capable model (preferred over Tesseract):
# NOTIV_VISION=auto  NOTIV_VISION_PROVIDERS=openai,groq,anthropic  NOTIV_VISION_PX=1200  NOTIV_VISION_WORKERS=2
# AI study material (summary, concepts, flashcards, quiz, concept map) after processing:
# NOTIV_AI_STUDY=auto  NOTIV_AI_CHUNK_CHARS=7000  NOTIV_AI_MAX_WAIT_SECONDS=900   (batch work waits out rate limits)
# NOTIV_LLM_HARD_COOLDOWN_SECONDS=600   (no credits / bad key / unsupported model: skip that provider for 10 minutes)
# NOTIV_MISTRAL_MODEL=mistral-large-latest
# NOTIV_ANTHROPIC_MODEL=claude-opus-5-5  NOTIV_ANTHROPIC_EFFORT=low  NOTIV_ANTHROPIC_SERVER_FALLBACK=1
# NOTIV_LLM_TIMEOUT_SECONDS=60  NOTIV_LLM_MAX_TOKENS=16000  NOTIV_LLM_COOLDOWN_SECONDS=30
# NOTIV_ASK_LLM=off                               # force quote-only Ask even when a provider is configured
# Retrieval: local (default; hash vectors, NOT semantic) | mistral (neural; needs MISTRAL_API_KEY + package). Provider failure -> BM25 fallback.
# NOTIV_EMBEDDINGS=local
# NOTIV_EMBED_TIMEOUT_SECONDS=15
# NOTIV_EMBED_COOLDOWN_SECONDS=30

# ── Sign-in: email + password only (no external identity provider). Optional operator-issued access tokens:
# NOTIV_SESSION_TTL_SECONDS=3600                             # lifetime of the Notiv bearer token minted after sign-in (300..86400)
# NOTIV_SHOW_TOKEN_SIGNIN=1                                  # 0 hides the "access token" form on /sign-in (recommended: password sign-in is the supported path)

# ── Local email/password accounts and password-reset delivery (no paid auth provider required)
# Local auth sessions use opaque HttpOnly cookies; set a strong NOTIV_AUTH_SECRET for operator-issued token sign-in too.
# Password reset is enabled only when SMTP is configured. Never commit SMTP credentials.
NOTIV_PUBLIC_BASE_URL=http://127.0.0.1:8000
NOTIV_SMTP_HOST=
NOTIV_SMTP_PORT=587
NOTIV_SMTP_USER=
NOTIV_SMTP_PASSWORD=
NOTIV_SMTP_FROM=
